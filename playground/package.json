{
  "name": "mlschema-playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --host 127.0.0.1 --port 10011 --strictPort",
    "build": "vp build",
    "preview": "vp preview --host 127.0.0.1 --port 10011 --strictPort",
    "typecheck": "vp exec tsc -p tsconfig.json --noEmit",
    "test:unit": "node --test tests/unit/*.test.ts",
    "test:runtime": "node --test tests/runtime/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/mona-sans": "5.3.0",
    "@lezer/highlight": "1.2.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "pyodide": "314.0.7",
    "typescript": "6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
